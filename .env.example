# Copy this file to .env and fill in the values locally.
# NEVER commit .env or real keys. Keep this file without values.

# Verda API key
VERDA_API_KEY=

# Google Gemini API key
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=

# Tiger Data (Postgres/Timescale) connection URL
TIGER_DATA_URL=

# MongoDB connection string
MONGODB_URI=

# ElevenLabs API key
ELEVENLABS_API_KEY=
