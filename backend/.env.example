# FICTITIOUS placeholders only. Keep actual values in environment / secret manager.
# DatabaseSettings loads backend/.env automatically; process variables take precedence.
# Use only HIILLOS_DB_*; DB_* aliases are not supported. Target schema is public.
HIILLOS_DB_HOST=postgres-hiillos-demo.example.invalid
HIILLOS_DB_PORT=5432
HIILLOS_DB_NAME=Hiillos
HIILLOS_DB_USER=hiillos_migration_example
