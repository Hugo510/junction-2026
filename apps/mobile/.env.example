# Copy to apps/mobile/.env (never commit it).
# EXPO_PUBLIC_* values are bundled into the app: NEVER put secrets here.

# Base URL of our backend (FastAPI on Modal), without /api/v1. Optional: leave it empty and the app
# runs fully on the phone. When set, it enables the check-in mirror, AI replies and the companion voice
# (the last two are opt-in in the Privacy screen).
EXPO_PUBLIC_API_URL=
